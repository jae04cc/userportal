# Copy to .env.local for local development. None of these are required to boot —
# the portal runs on local credentials with no status indicators until you set them.

# --- Database -------------------------------------------------------------
# Defaults to ./data/userportal.db
# DATABASE_PATH=/data/userportal.db

# --- Session signing ------------------------------------------------------
# Optional. If unset, a secret is generated once and persisted in app_settings.
# Set explicitly if you ever run more than one instance.
# AUTH_SECRET=

# --- Uptime Kuma ----------------------------------------------------------
# Both must be set for status indicators to appear. The slug must belong to a
# PUBLISHED status page containing the monitors you want to surface.
# KUMA_BASE_URL=https://uptime.example.com
# KUMA_STATUS_SLUG=services

# --- Authentik / OIDC -----------------------------------------------------
# All three must be set for the SSO button to appear on the login page.
# The redirect URI to register in Authentik is:
#   https://portal.example.com/api/auth/callback/oidc
# OIDC_ISSUER=https://authentik.example.com/application/o/portal/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Single sign-on

# --- Local login ----------------------------------------------------------
# Set to false once SSO is confirmed working to close the break-glass path.
# LOCAL_LOGIN_ENABLED=true
